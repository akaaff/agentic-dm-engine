__pycache__/
*.pyc
.venv/
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
*.db
*.sqlite3

# frontend
web/node_modules/
web/dist/

# training artifacts / model weights - large, regenerable, don't belong in git
data/training/raw/*.jsonl
data/training/curated/*.jsonl
models/
*.safetensors

# the centralized structured log stream (src.observability.log_event) -
# failed intents, backend errors, promoted warnings - plus the standalone
# log-watcher's own checkpoint/dedup state. Not regenerable (pulled from
# real sessions, not a script), but still local, personal working data
# rather than something to commit.
data/logs/*.jsonl
data/logs/.watcher_state.json
data/logs/*.log
data/logs/*.log.*

# generated scene images / portraits / narration audio - regenerable at runtime
data/generated_images/
data/portraits/
data/generated_audio/

# wandb local run cache (Day 26 fine-tune logging) - the run itself lives on wandb.ai
wandb/

# parallel-agent worktrees (Phase 9 initiative) - each is its own git checkout,
# not part of this repo's own tree
.claude/worktrees/
